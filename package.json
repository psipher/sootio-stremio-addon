{
	"name": "Sootio",
	"version": "1.9.1",
	"description": "Stremio Addon to search downloads and torrents in debrid services",
	"main": "api/index.js",
	"scripts": {
		"start": "node --max-old-space-size=2048 --expose-gc cluster.js",
		"start:dev": "cross-env LOG_LEVEL=debug node --max-old-space-size=2048 --expose-gc cluster.js",
		"standalone": "node --max-old-space-size=12000 --expose-gc server.js",
		"standalone:dev": "cross-env LOG_LEVEL=debug node --max-old-space-size=2048 --expose-gc server.js",
		"dev": "cross-env LOG_LEVEL=debug NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" nodemon server.js",
		"test": "node --experimental-vm-modules --max-old-space-size=2048 --expose-gc node_modules/jest/bin/jest.js",
		"check-domains": "node scripts/check-all-provider-domains.mjs",
		"test:e2e:mkvdrama": "node tests/mkvdrama-e2e-benchmark.js",
		"bench:mkvdrama": "node scripts/benchmark-mkvdrama-e2e.js",
		"build:logo": "node scripts/generate-logo.js"
	},
	"author": "Sooti",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@torbox/torbox-api": "^1.0.9",
		"@types/node": "^26.1.1",
		"all-debrid-api": "^1.3.3",
		"axios": "^1.18.1",
		"axios-cookiejar-support": "^7.0.0",
		"better-sqlite3": "^13.0.1",
		"cheerio": "^1.2.0",
		"cors": "^2.8.6",
		"debrid-link-api": "^1.0.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.0",
		"form-data": "^4.0.6",
		"fuse.js": "^7.5.0",
		"http-proxy-agent": "^9.1.0",
		"https-proxy-agent": "^9.1.0",
		"impit": "^0.14.3",
		"loglevel": "^1.9.2",
		"node-cache": "^5.1.2",
		"node-fetch": "^3.3.2",
		"parse-torrent-title": "github:TheBeastLT/parse-torrent-title#b98e2ba2fb64fd5fa1c34c620bd9050bbc2e271d",
		"pg": "^8.22.0",
		"premiumize-api": "^1.0.3",
		"prom-client": "^15.1.3",
		"puppeteer": "^25.3.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"real-debrid-api": "github:MrMonkey42/node-real-debrid#ea885a01e64c5543cda289c7fd1e8981d8c7d650",
		"request-ip": "^3.3.0",
		"router": "^2.2.0",
		"snowfl-api": "^1.1.0",
		"socks-proxy-agent": "^10.1.0",
		"stremio-addon-sdk": "^1.6.10",
		"swagger-stats": "^0.99.7",
		"tough-cookie": "^6.0.2",
		"urlencode": "^2.0.0",
		"ws": "^8.21.1",
		"xml2js": "^0.6.2"
	},
	"keywords": [
		"stremio",
		"stremio-addons",
		"addons"
	],
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"cross-env": "^10.1.0",
		"jest": "^30.4.2",
		"nodemon": "^3.1.14",
		"sharp": "^0.35.3"
	},
	"engines": {
		"node": ">=20.x",
		"pnpm": ">=9.x"
	}
}
